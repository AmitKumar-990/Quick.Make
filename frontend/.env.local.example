# API URL (your Express backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Site URL (for SEO canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://quickmake.app

# Google Search Console verification (get from Google Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# Optional: Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
